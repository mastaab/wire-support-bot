# Wire Support Bot configuration. Copy this file to .env and replace every placeholder.
# Never commit .env. Lines starting with # are comments; a commented setting keeps its default.

# ── Wire app ─────────────────────────────────────────────────────────────────
# App token issued by the Wire backend when the app was registered (scripts/register-app.mjs).
WIRE_SDK_API_TOKEN=replace-with-the-app-token
# Base URL of the Wire backend the app is registered on.
WIRE_SDK_API_HOST=https://wire-backend.example.com
# 32-byte key for the SDK's local crypto store, 64 hex characters (openssl rand -hex 32). Losing it loses the store.
WIRE_SDK_CRYPTO_KEY=replace-with-64-hex-characters
# The app's user ID on the Wire backend; checked at start-up.
WIRE_SDK_APP_ID=00000000-0000-0000-0000-000000000000
# The app's domain on the Wire backend; checked at start-up.
WIRE_SDK_APP_DOMAIN=wire.example.com
# Only for scripts/register-app.mjs: the team admin who registers the app (the password is prompted for when unset).
# WIRE_ADMIN_EMAIL=admin@example.com
# WIRE_ADMIN_PASSWORD=replace-with-the-admin-password

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection URL; docker-compose.yml overrides it for its own postgres service.
DATABASE_URL=postgres://wirebot:replace-with-a-password@localhost:5432/wire_support_bot

# ── Model endpoint and slots ─────────────────────────────────────────────────
# OpenAI-compatible chat-completions endpoint; the default is a local Ollama, so no message leaves the host.
WIRE_SUPPORT_BOT_LLM_BASE_URL=http://localhost:11434/v1
# API key for the endpoint; Ollama ignores it, so it may stay empty there.
WIRE_SUPPORT_BOT_LLM_API_KEY=
# Timeout per model call in milliseconds.
WIRE_SUPPORT_BOT_LLM_TIMEOUT_MS=60000
# Sent as reasoning_effort (none, low, medium or high); local thinking models such as Qwen under Ollama need none.
WIRE_SUPPORT_BOT_LLM_REASONING_EFFORT=none
# Model for classifying messages for passive help and for the support triage.
WIRE_SUPPORT_BOT_MODEL_CLASSIFY=qwen3-next:80b
# Model used when the classify model fails.
WIRE_SUPPORT_BOT_FALLBACK_CLASSIFY=qwen3-next:80b
# Model for answers to questions addressed to the bot.
WIRE_SUPPORT_BOT_MODEL_RESPOND=qwen3-next:80b
# Model used when the respond model fails.
WIRE_SUPPORT_BOT_FALLBACK_RESPOND=qwen3-next:80b

# ── Jira (required) ──────────────────────────────────────────────────────────
# REST base URL; for a scoped service-account token https://api.atlassian.com/ex/jira/<cloud id>.
WIRE_SUPPORT_BOT_JIRA_BASE_URL=https://api.atlassian.com/ex/jira/replace-with-the-cloud-id
# Site URL for links to tickets.
WIRE_SUPPORT_BOT_JIRA_SITE_URL=https://example.atlassian.net
# API token: a scoped token (Bearer), or a classic token together with WIRE_SUPPORT_BOT_JIRA_EMAIL (Basic).
WIRE_SUPPORT_BOT_JIRA_API_TOKEN=replace-with-the-jira-token
# Account e-mail for a classic token; leave unset for a scoped token.
# WIRE_SUPPORT_BOT_JIRA_EMAIL=service-account@example.com
# Key of the Jira Service Management project.
WIRE_SUPPORT_BOT_JIRA_PROJECT_KEY=DESK
# Numeric ID of the service desk.
WIRE_SUPPORT_BOT_JIRA_SERVICE_DESK_ID=1
# Request type ID per request kind (question, part, fault); fault is required and used for any kind without its own.
WIRE_SUPPORT_BOT_JIRA_REQUEST_TYPES=question=10001,part=10002,fault=10003
# Timeout per Jira call in milliseconds (a positive whole number; raised to 1000 if lower).
WIRE_SUPPORT_BOT_JIRA_TIMEOUT_MS=15000
# Whether live ticket status, SLAs and desk replies may reach the answer model (on or off); with a remote model this sends ticket content to it.
WIRE_SUPPORT_BOT_JIRA_SHARE_WITH_MODEL=off
# What the service desk handles, in plain words, for the model prompts (at most 500 characters); generic wording when unset.
# WIRE_SUPPORT_BOT_JIRA_SERVICE_SCOPE=IT problems, access requests and replacement equipment
# Desk agents who get a direct Wire conversation with the requester when assigned: <jira account id>=<wire handle>, comma-separated; needs the watch.
# WIRE_SUPPORT_BOT_JIRA_AGENTS=replace-with-account-id=replace-with-wire-handle

# ── Part orders ──────────────────────────────────────────────────────────────
# Label of the item a part is for, shown in confirmations and tickets (at most 40 characters).
WIRE_SUPPORT_BOT_PART_ASSET_LABEL=Asset
# How the bot asks for that item, completing "To order it I need ..." (at most 200 characters).
WIRE_SUPPORT_BOT_PART_ASSET_QUESTION=the item the part is for (for example a machine, vehicle or device)
# Delivery locations offered as buttons, plus [Other]: up to 5, separated by ";", each one line of at most 40 characters; unset: the location is asked in text.
# WIRE_SUPPORT_BOT_PART_DELIVERY_LOCATIONS=replace-with-location-1; replace-with-location-2

# ── Passive help and watch ───────────────────────────────────────────────────
# Whether the bot reads unaddressed messages and offers to raise, add to or resolve requests (on or off).
WIRE_SUPPORT_BOT_JIRA_PASSIVE=off
# Seconds between checks of open requests for desk replies, status and assignee changes (at least 15); unset: no watch.
WIRE_SUPPORT_BOT_JIRA_WATCH_SECONDS=30

# ── Logging and channels ─────────────────────────────────────────────────────
# Log level: debug, info, warn or error.
LOG_LEVEL=info
# Recent messages kept in memory per conversation as context (a positive whole number, capped at 500).
MESSAGE_BUFFER_SIZE=50
# Timezone for conversations the bot newly joins (an IANA name); members can change it per conversation.
WIRE_SUPPORT_BOT_DEFAULT_TIMEZONE=UTC

# ── Example: truck service desk ──────────────────────────────────────────────
# Uncomment and adapt for a desk that handles truck faults and replacement parts.
# WIRE_SUPPORT_BOT_JIRA_SERVICE_SCOPE=faults, breakdowns, damage, maintenance and replacement parts for the trucks of a haulage fleet
# WIRE_SUPPORT_BOT_JIRA_REQUEST_TYPES=question=10001,part=10002,fault=10003
# WIRE_SUPPORT_BOT_PART_ASSET_LABEL=Vehicle
# WIRE_SUPPORT_BOT_PART_ASSET_QUESTION=the vehicle (fleet or chassis number)
# WIRE_SUPPORT_BOT_PART_DELIVERY_LOCATIONS=Depot north; Depot south
