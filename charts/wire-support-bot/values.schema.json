{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wire Support Bot chart values",
  "type": "object",
  "properties": {
    "global": {
      "type": "object"
    },
    "nameOverride": {
      "type": "string",
      "description": "Overrides the chart name."
    },
    "fullnameOverride": {
      "type": "string",
      "description": "Overrides the full resource name."
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "description": "Container image repository."
        },
        "tag": {
          "type": "string",
          "description": "Image tag; empty: the chart's appVersion."
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ],
          "description": "Image pull policy."
        }
      },
      "required": [
        "repository"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Secrets for pulling the image."
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean",
          "description": "Whether the chart creates a service account."
        },
        "name": {
          "type": "string",
          "description": "Name of the service account."
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Extra pod annotations."
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Extra pod labels."
    },
    "podSecurityContext": {
      "type": [
        "object",
        "null"
      ],
      "description": "Pod security context."
    },
    "securityContext": {
      "type": [
        "object",
        "null"
      ],
      "description": "Container security context.",
      "properties": {
        "readOnlyRootFilesystem": {
          "type": "boolean"
        }
      }
    },
    "resources": {
      "type": [
        "object",
        "null"
      ],
      "description": "Container resources."
    },
    "nodeSelector": {
      "type": [
        "object",
        "null"
      ],
      "description": "Node selector."
    },
    "tolerations": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object"
      },
      "description": "Tolerations."
    },
    "affinity": {
      "type": [
        "object",
        "null"
      ],
      "description": "Affinity rules."
    },
    "extraEnv": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "name"
        ]
      },
      "description": "Extra environment variables (Kubernetes EnvVar objects)."
    },
    "extraVolumes": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "name"
        ]
      },
      "description": "Extra pod volumes (Kubernetes Volume objects)."
    },
    "extraVolumeMounts": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "name"
        ]
      },
      "description": "Extra volume mounts for the bot's container (Kubernetes VolumeMount objects)."
    },
    "extraContainers": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "name"
        ]
      },
      "description": "Extra containers in the pod (Kubernetes Container objects), for example a database proxy."
    },
    "existingSecret": {
      "type": "string",
      "description": "Name of an existing Secret with the Wire and Jira credentials; empty: the chart creates one from secrets.*."
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "description": "Postgres connection. Mode A: url.secretName set, a complete URL from that Secret. Mode B: the parts, with the password and every part that names a secretKey from secretName.",
      "properties": {
        "url": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {
              "type": "string",
              "description": "Mode A: Secret holding the complete URL; empty: mode B."
            },
            "secretKey": {
              "type": "string",
              "description": "Key of the URL in that Secret, for example uri."
            }
          }
        },
        "secretName": {
          "type": "string",
          "description": "Mode B: Secret holding the password and the parts that name a secretKey."
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ],
              "description": "DATABASE_HOST: host name or IP address."
            },
            "secretKey": {
              "type": "string",
              "description": "Key in database.secretName; when set, value is ignored."
            }
          }
        },
        "port": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": [
                "integer",
                "string",
                "null"
              ],
              "description": "DATABASE_PORT.",
              "minimum": 1,
              "maximum": 65535,
              "pattern": "^[0-9]*$"
            },
            "secretKey": {
              "type": "string",
              "description": "Key in database.secretName; when set, value is ignored."
            }
          }
        },
        "name": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ],
              "description": "DATABASE_NAME."
            },
            "secretKey": {
              "type": "string",
              "description": "Key in database.secretName; when set, value is ignored."
            }
          }
        },
        "user": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ],
              "description": "DATABASE_USER."
            },
            "secretKey": {
              "type": "string",
              "description": "Key in database.secretName; when set, value is ignored."
            }
          }
        },
        "password": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretKey": {
              "type": "string",
              "description": "Key of the password in database.secretName; there is no plain value."
            }
          }
        },
        "options": {
          "type": [
            "string",
            "null"
          ],
          "description": "DATABASE_OPTIONS: query parameters appended to the URL, for example sslmode=require."
        }
      },
      "if": {
        "properties": {
          "url": {
            "properties": {
              "secretName": {
                "minLength": 1
              }
            },
            "required": [
              "secretName"
            ]
          }
        },
        "required": [
          "url"
        ]
      },
      "then": {
        "properties": {
          "secretName": {
            "maxLength": 0
          }
        }
      },
      "else": {
        "properties": {
          "secretName": {
            "minLength": 1
          },
          "host": {
            "anyOf": [
              {
                "properties": {
                  "secretKey": {
                    "minLength": 1
                  }
                },
                "required": [
                  "secretKey"
                ]
              },
              {
                "properties": {
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "value"
                ]
              }
            ]
          },
          "password": {
            "properties": {
              "secretKey": {
                "minLength": 1
              }
            },
            "required": [
              "secretKey"
            ]
          }
        },
        "required": [
          "secretName",
          "host",
          "password"
        ]
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wireApiToken": {
          "type": [
            "string",
            "null"
          ],
          "description": "WIRE_SDK_API_TOKEN"
        },
        "wireCryptoKey": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([0-9a-fA-F]{64})?$",
          "description": "WIRE_SDK_CRYPTO_KEY, 64 hex characters."
        },
        "jiraApiToken": {
          "type": [
            "string",
            "null"
          ],
          "description": "WIRE_SUPPORT_BOT_JIRA_API_TOKEN"
        },
        "jiraEmail": {
          "type": [
            "string",
            "null"
          ],
          "description": "WIRE_SUPPORT_BOT_JIRA_EMAIL"
        },
        "llmApiKey": {
          "type": [
            "string",
            "null"
          ],
          "description": "WIRE_SUPPORT_BOT_LLM_API_KEY"
        },
        "embedApiKey": {
          "type": [
            "string",
            "null"
          ],
          "description": "WIRE_SUPPORT_BOT_EMBED_API_KEY"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wireApiHost": {
          "type": [
            "string",
            "null"
          ],
          "description": "WIRE_SDK_API_HOST"
        },
        "wireAppId": {
          "type": [
            "string",
            "null"
          ],
          "description": "WIRE_SDK_APP_ID"
        },
        "wireAppDomain": {
          "type": [
            "string",
            "null"
          ],
          "description": "WIRE_SDK_APP_DOMAIN"
        },
        "wireWatchdogMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "description": "WIRE_SUPPORT_BOT_WIRE_WATCHDOG_MINUTES, 0 (off) or 2 to 60; null: 5.",
          "anyOf": [
            { "type": "null" },
            { "const": 0 },
            { "minimum": 2, "maximum": 60 }
          ]
        },
        "llmBaseUrl": {
          "type": [
            "string",
            "null"
          ],
          "description": "WIRE_SUPPORT_BOT_LLM_BASE_URL"
        },
        "llmTimeoutMs": {
          "type": [
            "integer",
            "null"
          ],
          "description": "WIRE_SUPPORT_BOT_LLM_TIMEOUT_MS",
          "minimum": 1
        },
        "llmReasoningEffort": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "",
            "none",
            "low",
            "medium",
            "high",
            null
          ],
          "description": "WIRE_SUPPORT_BOT_LLM_REASONING_EFFORT: none, low, medium or high; empty: not sent."
        },
        "modelClassify": {
          "type": [
            "string",
            "null"
          ],
          "description": "WIRE_SUPPORT_BOT_MODEL_CLASSIFY"
        },
        "fallbackClassify": {
          "type": [
            "string",
            "null"
          ],
          "description": "WIRE_SUPPORT_BOT_FALLBACK_CLASSIFY"
        },
        "modelRespond": {
          "type": [
            "string",
            "null"
          ],
          "description": "WIRE_SUPPORT_BOT_MODEL_RESPOND"
        },
        "fallbackRespond": {
          "type": [
            "string",
            "null"
          ],
          "description": "WIRE_SUPPORT_BOT_FALLBACK_RESPOND"
        },
        "knowledge": {
          "type": "string",
          "enum": [
            "on",
            "off"
          ],
          "description": "WIRE_SUPPORT_BOT_KNOWLEDGE: on or off. Quote the value: YAML reads a bare on or off as a boolean."
        },
        "embedBaseUrl": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(https?://.+)?$",
          "description": "WIRE_SUPPORT_BOT_EMBED_BASE_URL, an http or https URL; required with knowledge on."
        },
        "embedModel": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\S*$",
          "description": "WIRE_SUPPORT_BOT_EMBED_MODEL, a model name without spaces."
        },
        "knowledgeResults": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 10,
          "description": "WIRE_SUPPORT_BOT_KNOWLEDGE_RESULTS, 1 to 10; null: 4."
        },
        "knowledgeMinScore": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "WIRE_SUPPORT_BOT_KNOWLEDGE_MIN_SCORE, a cosine similarity from 0 to 1; null: 0.5."
        },
        "jiraBaseUrl": {
          "type": [
            "string",
            "null"
          ],
          "description": "WIRE_SUPPORT_BOT_JIRA_BASE_URL"
        },
        "jiraSiteUrl": {
          "type": [
            "string",
            "null"
          ],
          "description": "WIRE_SUPPORT_BOT_JIRA_SITE_URL"
        },
        "jiraProjectKey": {
          "type": [
            "string",
            "null"
          ],
          "description": "WIRE_SUPPORT_BOT_JIRA_PROJECT_KEY"
        },
        "jiraServiceDeskId": {
          "type": [
            "string",
            "integer",
            "null"
          ],
          "pattern": "^[0-9]*$",
          "minimum": 0,
          "description": "WIRE_SUPPORT_BOT_JIRA_SERVICE_DESK_ID, a numeric ID."
        },
        "jiraRequestTypes": {
          "type": [
            "string",
            "null"
          ],
          "description": "WIRE_SUPPORT_BOT_JIRA_REQUEST_TYPES"
        },
        "jiraTimeoutMs": {
          "type": [
            "integer",
            "null"
          ],
          "description": "WIRE_SUPPORT_BOT_JIRA_TIMEOUT_MS",
          "minimum": 1
        },
        "jiraShareWithModel": {
          "type": "string",
          "enum": [
            "on",
            "off"
          ],
          "description": "WIRE_SUPPORT_BOT_JIRA_SHARE_WITH_MODEL: on or off. Quote the value: YAML reads a bare on or off as a boolean."
        },
        "jiraServiceScope": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500,
          "description": "WIRE_SUPPORT_BOT_JIRA_SERVICE_SCOPE, at most 500 characters."
        },
        "jiraAgents": {
          "type": [
            "string",
            "null"
          ],
          "description": "WIRE_SUPPORT_BOT_JIRA_AGENTS"
        },
        "jiraAgentChat": {
          "type": "string",
          "enum": [
            "ask",
            "auto",
            "off"
          ],
          "description": "WIRE_SUPPORT_BOT_JIRA_AGENT_CHAT: ask, auto or off. Quote off: YAML reads a bare off as a boolean."
        },
        "partAssetLabel": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40,
          "description": "WIRE_SUPPORT_BOT_PART_ASSET_LABEL, at most 40 characters."
        },
        "partAssetQuestion": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200,
          "description": "WIRE_SUPPORT_BOT_PART_ASSET_QUESTION, at most 200 characters."
        },
        "partDeliveryLocations": {
          "type": [
            "string",
            "null"
          ],
          "description": "WIRE_SUPPORT_BOT_PART_DELIVERY_LOCATIONS"
        },
        "jiraPassive": {
          "type": "string",
          "enum": [
            "on",
            "off"
          ],
          "description": "WIRE_SUPPORT_BOT_JIRA_PASSIVE: on or off. Quote the value: YAML reads a bare on or off as a boolean."
        },
        "jiraWatchSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "description": "WIRE_SUPPORT_BOT_JIRA_WATCH_SECONDS, at least 15; null: no watch.",
          "minimum": 15
        },
        "jiraUpdateQuestionHours": {
          "type": [
            "integer",
            "null"
          ],
          "description": "WIRE_SUPPORT_BOT_JIRA_UPDATE_QUESTION_HOURS, 0 to 72; null: 4.",
          "minimum": 0,
          "maximum": 72
        },
        "jiraFeedback": {
          "type": "string",
          "enum": [
            "on",
            "off"
          ],
          "description": "WIRE_SUPPORT_BOT_JIRA_FEEDBACK: on or off. Quote the value: YAML reads a bare on or off as a boolean."
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "description": "LOG_LEVEL."
        },
        "logFormat": {
          "type": "string",
          "enum": [
            "json",
            "ecs"
          ],
          "description": "LOG_FORMAT."
        },
        "sdkLogLevel": {
          "type": "string",
          "enum": [
            "off",
            "error",
            "warn",
            "info",
            "debug"
          ],
          "description": "WIRE_SUPPORT_BOT_SDK_LOG_LEVEL: off, error, warn, info or debug. Quote off: YAML reads a bare off as a boolean."
        },
        "sdkLogContent": {
          "type": "string",
          "enum": [
            "none",
            "messages",
            "full"
          ],
          "description": "WIRE_SUPPORT_BOT_SDK_LOG_CONTENT."
        },
        "messageBufferSize": {
          "type": [
            "integer",
            "null"
          ],
          "description": "MESSAGE_BUFFER_SIZE, a positive whole number (capped at 500 by the app).",
          "minimum": 1
        },
        "defaultTimezone": {
          "type": [
            "string",
            "null"
          ],
          "description": "WIRE_SUPPORT_BOT_DEFAULT_TIMEZONE, an IANA name."
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingClaim": {
          "type": "string",
          "description": "Name of an existing PersistentVolumeClaim."
        },
        "size": {
          "type": "string",
          "minLength": 1,
          "description": "Size of the claim the chart creates."
        },
        "storageClass": {
          "type": "string",
          "description": "Storage class; empty: the cluster default."
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether the metrics and health endpoint, its Service and the liveness probe are added."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "WIRE_SUPPORT_BOT_METRICS_PORT, the port of the endpoint and the Service."
        },
        "livenessProbe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          },
          "description": "Liveness probe on /healthz."
        },
        "podAnnotations": {
          "type": "boolean",
          "description": "Whether the pod gets the prometheus.io/scrape, port and path annotations."
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Whether a ServiceMonitor for the Prometheus Operator is created."
            },
            "interval": {
              "type": "string",
              "pattern": "^([0-9]+(ms|s|m|h))+$",
              "description": "Scrape interval, for example 30s."
            },
            "scrapeTimeout": {
              "type": "string",
              "pattern": "^([0-9]+(ms|s|m|h))+$",
              "description": "Scrape timeout, for example 10s."
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Extra labels on the ServiceMonitor."
            }
          }
        }
      }
    }
  }
}
